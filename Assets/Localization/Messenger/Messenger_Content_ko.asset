  m_TableData:
  - m_Id: 98652626817024
    m_Localized: "\uC548\uB155\uD558\uC138\uC694! \uC800 \uC194\uC774\uC5D0\uC694.
      \n\uB0B4\uC77C\uC774 \uB108\uBB34 \uAE30\uB300\uB3FC\uC11C \uC7A0\uC774 \uC548
      \uC640\uC11C\uC694\u2026 \uD5E4\uD5E4.\n\uC800\uB294 \uD56D\uC0C1 \uCE5C\uAD6C\uB4E4\uC774\uB791
      \uB6F0\uC5B4\uB178\uB294 \uAC8C \uC18C\uC6D0\uC774\uC5C8\uAC70\uB4E0\uC694.\n{playerName}\uB2D8\uC774
      \uADF8 \uC18C\uC6D0\uC744 \uC774\uB904\uC8FC\uC2E4\uC9C0\uB3C4 \uBAB0\uB77C\uC694.
      \uB450\uADFC\uB450\uADFC!\n\uC544, \uC774\uC81C \uB2A6\uC5C8\uB124\uC694. \uC800\uB294
      \uCF54 \uC790\uB7EC \uAC08\uAC8C\uC694.\n\uB0B4\uC77C \uBD10\uC694! \uAF2D\uC774\uC5D0\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 98652626817025
    m_Localized: "\uC194\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 394936105504768
    m_Localized: "\uC194\uC774\uB791 \uC774\uC57C\uAE30 \uC798\uD588\uC9C0? \uCC98\uC74C\uC774\uB77C
      \uAE34\uC7A5\uD588\uC744 \uD150\uB370, \uB108\uBB34 \uC218\uACE0 \uB9CE\uC558\uC5B4!!\n\uC624\uB298\uC740
      \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0, \uB9C8\uC744\uC744 \uCC9C\uCC9C\uD788
      \uD55C \uBC14\uD034 \uB3CC\uC544\uBD10.\n\uADF8\uB7EC\uBA74\uC11C \uB2E4\uB978
      \uC601\uD63C\uB4E4\uACFC\uB3C4 \uAC00\uBCCD\uAC8C \uC548\uBD80 \uB098\uB204\uB294\uAC83\uB3C4
      \uC88B\uC544~\n\uC5EC\uAE34 \uAC01\uC790 \uC0AC\uC5F0\uC774 \uB9CE\uC544. \uC815\uB2F5\uC744
      \uCC3E\uAE30\uBCF4\uB2E4, \uB9C8\uC74C\uC744 \uBA3C\uC800 \uB4E4\uC5B4\uC8FC\uB294
      \uAC8C \uC911\uC694\uD574.\n\uADF8\uB7FC {playerName}. \uC55E\uC73C\uB85C \uD30C\uC774\uD305\uC774\uC57C~!!"
    m_Metadata:
      m_Items: []
  - m_Id: 394936113893376
    m_Localized: "\uC0C1\uC0AC"
    m_Metadata:
      m_Items: []

  m_TableData:
  - m_Id: 272881414144
    m_Localized: "\uC548\uB155, {playerName} \uC528! \uC6B0\uB9AC \uD68C\uC0AC\uC5D0
      \uC628 \uAC78 \uD658\uC601\uD574~ \uC624\uB298 \uCCAB \uADFC\uBB34\uB77C\uACE0
      \uB4E4\uC5C8\uC5B4.\n\uC6B0\uB9AC\uB294 \uC601\uD63C\uC744 \uCE58\uC720\uD574
      \uC8FC\uB294 \uC77C\uC744 \uD558\uACE0 \uC788\uC5B4.\n\uADF8\uB7EC\uB2C8\uAE4C\u2026
      \uC0C1\uCC98\uBC1B\uC740 \uC601\uD63C\uB4E4\uC744 \uCE58\uC720\uD558\uB294
      \uAC8C {playerName} \uC528\uC758 \uC5C5\uBB34\uC57C.\n\u2018\uBCC4\uBB34\uB9AC\uD130\u2019
      \uB9C8\uC744\uC758 \uC601\uD63C\uB4E4\uC744 \uC804\uB2F4\uD558\uAC8C \uB420
      \uD14C\uB2C8, \uAC70\uAE30\uB85C \uCD9C\uADFC\uD558\uBA74 \uB3FC!\n\u2018\uBCC4\uBB34\uB9AC\uD130\u2019\uC5D0
      \uC624\uBA74 \uB0B4\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 80005585899520
    m_Localized: "\uC0C1\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 98652626817024
    m_Localized: "\uC548\uB155\uD558\uC138\uC694! \uC194\uC774\uC5D0\uC694. \uD5E4\uD5E4.\n\uB0B4\uC77C\uC774
      \uB108\uBB34 \uAE30\uB300\uB3FC\uC11C \uC7A0\uC774 \uC548 \uC640\uC11C\uC694\u2026
      \uC5F0\uB77D\uB4DC\uB838\uC5B4\uC694!\n\uC800\uB294 \uD56D\uC0C1 \uCE5C\uAD6C\uB4E4\uC774\uB791
      \uB6F0\uC5B4\uB178\uB294 \uAC8C \uC18C\uC6D0\uC774\uC5C8\uAC70\uB4E0\uC694.\n{playerName}\uB2D8\uC774
      \uADF8 \uC18C\uC6D0\uC744 \uC774\uB904\uC8FC\uC2E4\uC9C0\uB3C4 \uBAB0\uB77C\uC694.
      \uB450\uADFC\uB450\uADFC!\n\uC544, \uC774\uC81C \uB2A6\uC5C8\uB124\uC694. \uC800\uB294
      \uC790\uB7EC \uAC08\uAC8C\uC694.\n\uB0B4\uC77C \uBD2C\uC694! \uAF2D\uC774\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 98652626817025
    m_Localized: "\uC194\uC774"
    m_Metadata:
      m_Items: []

  m_TableData:
  - m_Id: 2339830697984
    m_Localized: "\uB0B4 \uBAA9\uC18C\uB9AC \uB4E4\uB9AC\uC9C0 {playerName}?"
    m_Metadata:
      m_Items: []
  - m_Id: 2339864252416
    m_Localized: "\uB108\uB294 \uC9C0\uAE08 \uC194\uC774\uC758 \uBAB8 \uC18D\uC5D0
      \uB4E4\uC5B4\uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 2339864252417
    m_Localized: "... \uD5C9!! \uC774\uB7F0!"
    m_Metadata:
      m_Items: []
  - m_Id: 2339864252418
    m_Localized: "\uBC31\uD608\uAD6C\uB4E4\uC774 \uACE7 \uB108\uB97C \uACF5\uACA9\uD574\uC62C
      \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2339864252419
    m_Localized: "\uB0B4\uAC00 \uB108\uC5D0\uAC8C \uBB34\uAE30\uB97C \uBCF4\uB0B4\uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 2339864252420
    m_Localized: "\uC774 \uC8FC\uC0AC\uAE30\uB97C \uB4E4\uACE0 \uB9C8\uC6B0\uC2A4
      \uD074\uB9AD\uC73C\uB85C \uBC31\uD608\uAD6C\uB4E4\uC744 \uB9DE\uD788\uBA74
      \uB3FC!"
    m_Metadata:
      m_Items: []
  - m_Id: 2339864252421
    m_Localized: "\uC194\uC774\uB97C \uC544\uD504\uAC8C\uD55C \uC8FC\uBC94\uB4E4\uC744
      \uC5BC\uB978 \uD574\uCE58\uC6CC\uBC84\uB824!!"
    m_Metadata:
      m_Items: []

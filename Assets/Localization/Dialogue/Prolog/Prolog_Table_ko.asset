  m_TableData:
  - m_Id: 5172039680
    m_Localized: "\uC624, \uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uC774\uB85C\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004160
    m_Localized: "\uD639\uC2DC\u2026 \uC5EC\uAE30\uB294 \uC5B4\uB514\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004161
    m_Localized: "\uC800\uB7F0. \uC774\uACF3\uC774 \uC5B4\uB514\uC778\uC9C0 \uBAA8\uB974\uB294
      \uAC70\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004162
    m_Localized: "\uB124. \uC81C\uAC00 \uBB58 \uD558\uACE0 \uC788\uC5C8\uB294\uC9C0\uB3C4...
      \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198464
    m_Localized: "\uD558\uD558, \uC774\uACF3\uC5D0 \uC628 \uB370\uC5D0\uB294 \uB2E4
      \uC774\uC720\uAC00 \uC788\uC744 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198465
    m_Localized: "\uB0B4 \uB9C8\uCE68 \uC790\uB124\uC5D0\uAC8C \uC904 \uC218 \uC788\uB294
      \uC9D1\uC774 \uC788\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198466
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uD3B8\uD788 \uC26C\uBA74\uC11C \uAE30\uC5B5\uC744
      \uB418\uCC3E\uB294 \uAC8C \uC5B4\uB5A4\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198467
    m_Localized: "\uD558\uC9C0\uB9CC\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198468
    m_Localized: "\uB300\uC2E0 \uB0B4 \uD68C\uC0AC\uC5D0\uC11C \uC77C\uC744 \uD574\uBCF4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198469
    m_Localized: "\uC9C1\uC7A5\uC5D0\uC11C \uC8FC\uB294 \uC219\uC18C\uB77C\uACE0
      \uC0DD\uAC01\uD558\uBA74, \uC88B\uC9C0 \uC54A\uC740\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198470
    m_Localized: "\uC774\uB7F0 \uBCF5\uC9C0 \uC88B\uC740 \uD68C\uC0AC \uC5BC\uB9C8
      \uC5C6\uC18C! \uD558\uD558!"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198471
    m_Localized: "\u2026 \uADF8\uB7FC, \uADF8\uB807\uAC8C \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198472
    m_Localized: "\uC88B\uC544. \uADF8\uB7FC \uC790\uB124\uB97C \uC9D1\uC73C\uB85C
      \uB370\uB824\uB2E4 \uC904\uD14C\uB2C8, \uD3B8\uD788 \uB208\uC744 \uAC10\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198473
    m_Localized: "\uC624\uB298\uC740 \uD479 \uC26C\uACE0, \uB0B4\uC77C\uBD80\uD130
      \uC77C\uC744 \uC2DC\uC791\uD558\uBA74 \uB41C\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198474
    m_Localized: "\uADF8\uB7FC \uD589\uC6B4\uC744 \uBE4C\uACA0\uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198475
    m_Localized: "\uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC70\uC9C0..."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198476
    m_Localized: "\uC77C\uB2E8 \uC790\uB7EC\uAC00\uC790."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

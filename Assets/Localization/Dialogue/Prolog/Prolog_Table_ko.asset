  m_TableData:
  - m_Id: 5172039680
    m_Localized: "\uC624, \uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uC774\uB85C\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004160
    m_Localized: "\uD639\uC2DC\u2026 \uC5EC\uAE30\uB294 \uC5B4\uB514\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004161
    m_Localized: "\uC800\uB7F0. \uC774\uACF3\uC774 \uC5B4\uB514\uC778\uC9C0 \uBAA8\uB974\uB294
      \uAC70\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004162
    m_Localized: "\uB124. \uC81C\uAC00 \uBB58 \uD558\uACE0 \uC788\uC5C8\uB294\uC9C0\uB3C4...
      \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198464
    m_Localized: "\uD558\uD558, \uC774\uACF3\uC5D0 \uC628 \uB370\uC5D0\uB294 \uB2E4
      \uC774\uC720\uAC00 \uC788\uC744 \uAC8C\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198465
    m_Localized: "\uB0B4 \uB9C8\uCE68 \uC790\uB124\uC5D0\uAC8C \uC904 \uC218 \uC788\uB294
      \uC9D1\uC774 \uC788\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198466
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uD3B8\uD788 \uC26C\uBA74\uC11C \uAE30\uC5B5\uC744
      \uB418\uCC3E\uB294 \uAC8C \uC5B4\uB5A4\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198467
    m_Localized: "\uD558\uC9C0\uB9CC\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198468
    m_Localized: "\uBB3C\uB860! \uACF5\uC9DC\uB85C \uC8FC\uB294 \uAC74 \uC544\uB2C8\uC624.
      \uD558\uD558\uD558!"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198469
    m_Localized: "\uC6D4\uC138\uB97C 80 \uC815\uB3C4 \uBC1B\uAE34 \uD560 \uAC83\uC774\uB77C\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198470
    m_Localized: "\uC544\uCC38, \uB0B4 \uD68C\uC0AC\uC5D0\uC11C \uB9C8\uCE68 \uC2E0\uC785\uC744
      \uBF51\uACE0 \uC788\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198472
    m_Localized: "\uB530\uB85C \uD798\uACB9\uAC8C \uC77C\uC790\uB9AC \uAD6C\uD558\uB7EC
      \uB2E4\uB2D0 \uD544\uC694\uB3C4 \uC5C6\uACE0, \uC88B\uC9C0 \uC54A\uC740\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198474
    m_Localized: "\uC88B\uC544. \uADF8\uB7FC \uC790\uB124\uB97C \uC9D1\uC73C\uB85C
      \uB370\uB824\uB2E4 \uC8FC\uACA0\uB124. \uD3B8\uD788 \uB208\uC744 \uAC10\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 9458719553687552
    m_Localized: "\uC6B0\uB9AC \uD68C\uC0AC\uC5D0\uC11C \uC77C\uC744 \uD558\uBA70
      \uB3C8\uC744 \uBC84\uB294 \uAC83\uC774 \uC5B4\uB5A4\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 9458719599824896
    m_Localized: "\u2026 \uADF8\uB7FC, \uADF8\uB807\uAC8C \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9458719599824897
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uC0B4\uBA74 \uB41C\uB2E4\uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 9458719599824898
    m_Localized: "\uC624\uB298\uC740 \uD479 \uC26C\uACE0, \uB0B4\uC77C\uBD80\uD130
      \uC77C\uC744 \uC2DC\uC791\uD558\uBA74 \uB420 \uAC8C\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 11170835843190784
    m_Localized: "\uADF8\uB7FC \uD589\uC6B4\uC744 \uBE4C\uACA0\uB124!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

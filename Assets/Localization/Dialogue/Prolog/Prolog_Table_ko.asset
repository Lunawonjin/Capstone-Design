  m_TableData:
  - m_Id: 5172039680
    m_Localized: "\uC624, \uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004160
    m_Localized: "\uD639\uC2DC\u2026 \uC5EC\uAE30\uB294 \uC5B4\uB514\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004161
    m_Localized: "\uC774\uACF3\uC774 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064583004162
    m_Localized: "\uB124. \uC81C\uAC00 \uBB58 \uD558\uACE0 \uC788\uC5C8\uB294\uC9C0\uB3C4...
      \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198464
    m_Localized: "\uC74C... \uC774\uACF3\uC5D0 \uC628 \uB370\uC5D4 \uB098\uB984\uC758
      \uC0AC\uC815\uC774 \uC788\uAE30 \uB9C8\uB828\uC774\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198465
    m_Localized: "\uC81C\uAC00 \uAD00\uB9AC\uD558\uB294 \uBE44\uC5B4\uC788\uB294
      \uC9D1\uC774 \uD558\uB098 \uC788\uB294\uB370,"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198466
    m_Localized: "\uADF8\uACF3\uC5D0\uC11C \uD3B8\uD788 \uC9C0\uB0B4\uBA70 \uCC9C\uCC9C\uD788
      \uAE30\uC5B5\uC744 \uB418\uCC3E\uB294 \uAC8C \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198467
    m_Localized: "\uD558\uC9C0\uB9CC\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198468
    m_Localized: "\uD558\uD558, \uBB3C\uB860 \uACF5\uC9DC\uB85C \uC8FC\uB294 \uAC74
      \uC544\uB2C8\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198469
    m_Localized: "\uC6D4\uC138\uB294... \uC74C, 80 \uC815\uB3C4\uBA74 \uC801\uB2F9\uD558\uACA0\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198470
    m_Localized: "\uB9C8\uCE68 \uC6B0\uB9AC \uD68C\uC0AC\uC5D0\uC11C \uC0C8\uB85C\uC6B4
      \uC9C1\uC6D0\uC744 \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198472
    m_Localized: "\uC6B0\uB9AC \uD68C\uC0AC\uC5D0\uC11C \uC77C\uD574\uBCF4\uB294
      \uAC74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 42064587198474
    m_Localized: "\uC88B\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uBC14\uB85C \uC9D1\uC73C\uB85C
      \uC548\uB0B4\uD574 \uB4DC\uB9AC\uC8E0. \uC7A0\uC2DC \uB208\uC744..."
    m_Metadata:
      m_Items: []
  - m_Id: 9458719553687552
    m_Localized: "\uC544\uBB34\uB798\uB3C4 \uC0DD\uD65C\uBE44\uAC00 \uD544\uC694\uD560
      \uD150\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 9458719599824896
    m_Localized: "\u2026!! \uADF8\uB7FC, \uADF8\uB807\uAC8C \uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9458719599824897
    m_Localized: "\uC790, \uC774\uACF3\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9458719599824898
    m_Localized: "\uC624\uB298\uC740 \uD479 \uC26C\uACE0, \uB0B4\uC77C\uBD80\uD130
      \uC77C\uC744 \uCC28\uADFC\uCC28\uADFC \uC2DC\uC791\uD574 \uBCF4\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 11170835843190784
    m_Localized: "\uADF8\uB7FC... \uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

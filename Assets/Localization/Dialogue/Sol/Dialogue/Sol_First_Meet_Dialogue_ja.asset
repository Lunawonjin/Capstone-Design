      m_Items: []
  - m_Id: 16216976985100292
    m_Localized: "\u308F\u305F\u3057\u3082\u5B66\u6821\u3067\u53CB\u3060\u3061\u3068\u4E00\u7DD2\u306B\u904A\u3073\u305F\u3044\u3067\u3059\uFF01"

    m_Localized: "\u30BD\u30EB\u3001\u3053\u3093\u306B\u3061\u306F\u3002\n\u3053\u3061\u3089\u306F\u65B0\u3057\u304F\u6765\u305F{playerName}\u3055\u3093\u3067\u3059\u3002\n\u3053\u308C\u304B\u3089\u3042\u306A\u305F\u306E\u3053\u3068\u3092\u898B\u3066\u304F\u308C\u307E\u3059\u3088\u3002"

    m_Localized: "\u30BD\u30EB\u306F\u3069\u3053\u304C\u60AA\u3044\u306E?\n\u6CE8\u5C04\u3092\u6253\u3063\u3066\u3044\u308B\u306E\u3092\u898B\u305F\u304B\u3089\u3002"

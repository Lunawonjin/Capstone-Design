      m_Items: []
  - m_Id: 221271946162176
    m_Localized: "\u304A\u59C9\u3055\u3093\u306F\u5B66\u6821\u306B\u901A\u3063\u3066\u305F\u3088\u306D\uFF1F
      \n\u30BD\u30EB\u306F\u884C\u3051\u306A\u304F\u3066\u3001\u3061\u3087\u3063\u3068\u5FC3\u6B8B\u308A\u3067\u2026"

    m_Localized: "\u660E\u65E5\u3082\u6765\u3066\u304F\u308C\u307E\u3059\u3088\u306D\u3002\u79C1\u306F\u3053\u3053\u3067\u5F85\u3063\u3066\u307E\u3059\u3002\u7D04\u675F\u3067\u3059\u3002"

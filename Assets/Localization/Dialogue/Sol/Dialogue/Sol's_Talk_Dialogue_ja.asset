  - m_Id: 1763493162717201
    m_Localized: "\u3064\u3089\u3044\u65E5\u306B\u3082\u3044\u3044\u3053\u3068\u306F\u3042\u308A\u307E\u3059\u3002{playerName}\u3055\u3093\u304C\u6765\u3066\u304F\u308C\u308B\u3053\u3068\u3002"

      m_Items: []
  - m_Id: 1763493162717190
    m_Localized: "\u96E8\u306E\u65E5\u3082\u597D\u304D\u3067\u3059\u3002\u96E8\u7C92\u306E\u97F3\u304C\u5B50\u5B88\u6B4C\u307F\u305F\u3044\u3067\u3002"

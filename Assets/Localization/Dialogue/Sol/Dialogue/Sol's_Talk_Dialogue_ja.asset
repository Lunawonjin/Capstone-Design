      m_Items: []
  - m_Id: 1763493162717192
    m_Localized: "\u4ECA\u65E5\u306F\u300E\u30C3\u30AD\u30F3\u300F\u3068\u7D75\u65E5\u8A18\u3092\u66F8\u304D\u305F\u3044\u3067\u3059\u3002{playerName}\u3055\u3093\u3082\u624B\u4F1D\u3063\u3066\u304F\u308C\u307E\u3059\u304B\u3002"

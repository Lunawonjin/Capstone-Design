      m_Items: []
  - m_Id: 1763493162717195
    m_Localized: "{playerName}\u3055\u3093\u306F\u3069\u3093\u306A\u904A\u3073\u304C\u597D\u304D\u3067\u3059\u304B\u3002\u79C1\u306F\u9B3C\u3054\u3063\u3053\u304C\u597D\u304D\uFF01"

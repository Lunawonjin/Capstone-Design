    m_Localized: "\u5927\u4EBA\u305F\u3061\u306F\u79C1\u306B\u3059\u3054\u304F\u6C17\u3092\u3064\u304B\u3044\u307E\u3059\u3002\u3067\u3082\u3001\u79C1\u306F\u306B\u3063\u3053\u308A\u7B11\u3048\u307E\u3059\u3002"

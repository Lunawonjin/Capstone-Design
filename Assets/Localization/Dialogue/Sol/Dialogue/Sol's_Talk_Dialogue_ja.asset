    m_Localized: "{playerName}\u3055\u3093\u304C\u6765\u308B\u3068\u5FC3\u304C\u843D\u3061\u7740\u304D\u307E\u3059\u3002\u3060\u304B\u3089\u5F85\u3063\u3066\u307E\u3057\u305F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1763493162717188
    m_Localized: "\u8D70\u308A\u305F\u3044\u6C17\u6301\u3061\u304C\u30C9\u30AD\u30C9\u30AD\u3067\u3059\u3002\u3067\u3082\u3001\u3086\u3063\u304F\u308A\u4E00\u7DD2\u306B\u3044\u3066\u304F\u308C\u308B\u3060\u3051\u3067\u3082\u3046\u308C\u3057\u3044\u3067\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1763493162717189
    m_Localized: "\u5916\u304B\u3089\u7B11\u3044\u58F0\u304C\u805E\u3053\u3048\u308B\u3068\u3001\u79C1\u3082\u3064\u3089\u308C\u3066\u7B11\u3063\u3061\u3083\u3044\u307E\u3059\u3002"

      m_Items: []
  - m_Id: 1763493162717191
    m_Localized: "\u79C1\u3001\u79D8\u5BC6\u3092\u5B88\u308B\u306E\u304C\u5F97\u610F\u3067\u3059\u3002\u3060\u304B\u3089\u4EBA\u306E\u8A71\u3092\u9759\u304B\u306B\u805E\u304F\u3093\u3067\u3059\u3002"

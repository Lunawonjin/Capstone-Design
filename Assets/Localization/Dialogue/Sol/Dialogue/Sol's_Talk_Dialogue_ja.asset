      m_Items: []
  - m_Id: 1763493162717200
    m_Localized: "\u305F\u307E\u306B\u7A93\u306E\u5916\u3092\u9577\u304F\u898B\u307E\u3059\u3002\u5916\u306B\u51FA\u306A\u304F\u3066\u3082\u3001\u98A8\u306E\u97F3\u306F\u805E\u3053\u3048\u308B\u304B\u3089\u3002"

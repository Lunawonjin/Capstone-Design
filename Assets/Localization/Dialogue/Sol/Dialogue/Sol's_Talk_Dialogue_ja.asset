    m_Localized: "\u300E\u30C3\u30AD\u30F3\u300F\u306E\u624B\u3092\u304E\u3085\u3063\u3068\u63E1\u308B\u3068\u3001\u306A\u3093\u3067\u3082\u3067\u304D\u308B\u6C17\u304C\u3057\u307E\u3059\u3002"

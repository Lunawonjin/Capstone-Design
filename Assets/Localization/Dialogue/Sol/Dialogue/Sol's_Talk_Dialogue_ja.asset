  - m_Id: 1763493099802624
    m_Localized: "\u3053\u3093\u306B\u3061\u306F\u3001{playerName}\u3055\u3093\uFF01
      \u4ECA\u65E5\u306F\u4F55\u304B\u3089\u304A\u8A71\u3057\u307E\u3057\u3087\u3046\u304B\u3002"

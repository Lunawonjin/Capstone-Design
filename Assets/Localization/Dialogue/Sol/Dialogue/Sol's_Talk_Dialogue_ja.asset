  - m_Id: 1763493162717205
    m_Localized: "\u3067\u3082\u5927\u4E08\u592B\u3067\u3059\u3002{playerName}\u3055\u3093\u304C\u305D\u3070\u306B\u3044\u308B\u3068\u3001\u52C7\u6C17\u304C\u51FA\u307E\u3059\u304B\u3089\u3002"

    m_Localized: "\u305F\u307E\u306B\u80F8\u304C\u30C9\u30AD\u30C9\u30AD\u3057\u3066\u3082\u2026\u5927\u4E08\u592B\u3067\u3059\u3002\u3059\u3050\u843D\u3061\u7740\u304D\u307E\u3059\u304B\u3089\u3002"

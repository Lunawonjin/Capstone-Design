  m_TableData:
  - m_Id: 509151219712
    m_Localized: "\uC624\uB298 \uD37C\uC990 \uB300\uC2E0 \uB9DE\uCDB0\uC918\uC11C
      \uACE0\uB9C8\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 509188968448
    m_Localized: "\uC774\uB7F0 \uAC70 \uC6B0\uB9AC \uC5C4\uB9C8\uC544\uBE60\uB3C4
      \uC548 \uB3C4\uC640\uC92C\uB294\uB370\uC5D0..."
    m_Metadata:
      m_Items: []
  - m_Id: 509188968449
    m_Localized: "\uC5C4\uB9C8\uC544\uBE60\uB294 \uB9E8\uB0A0 \uB0B4 \uBC29\uC5D0
      \uB4E4\uC5B4\uC624\uBA74 \uD55C\uC228\uB9CC \uC26C\uACE0,"
    m_Metadata:
      m_Items: []
  - m_Id: 509188968450
    m_Localized: "\uD56D\uC0C1 \uC194\uC774\uD55C\uD14C \uB098\uC05C\uD45C\uC815!
      \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1843936302141440
    m_Localized: "\uC5D0\uC774~ \uADF8\uB7F4\uB9AC\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573773606912
    m_Localized: "\uCC29\uAC01\uC778 \uAC70 \uC544\uB2C8\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938561
    m_Localized: "\uC194\uC774\uAC00 \uADC0\uCC2E\uC558\uC744 \uAC70\uC608\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938562
    m_Localized: "\uB098\uB791 \uB6F0\uC5B4\uB180\uC544 \uC8FC\uC9C0\uB3C4 \uC54A\uACE0
      \uD56D\uC0C1!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938563
    m_Localized: "\uD750\uC544\uC559!"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938564
    m_Localized: "\uC5B4\uB514\uAC00 \uC544\uD320\uB294\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938565
    m_Localized: "\uC6B8\uC9C0\uB9C8..."
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938566
    m_Localized: "\uC194\uC774\uB294... \uBC30\uCF24\uBCD1?\uC774\uB7AC\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938567
    m_Localized: "\uADF8\uB798\uC11C, \uB9C9! \uB9E8~\uB0A0 \uB204\uC6CC\uB9CC \uC788\uC73C\uB77C\uACE0
      \uD558\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938568
    m_Localized: "\uC194\uC774\uB294 \uC5C4\uB9C8\uC544\uBE60\uB791 \uB180\uACE0
      \uC2F6\uC740\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938569
    m_Localized: "\uB2E4\uB978 \uC560\uB4E4\uB3C4 \uBCD1\uC6D0\uC5D0\uC11C \uAC19\uC774
      \uC0B4\uC558\uAC70\uB4E0\uC694...?"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938570
    m_Localized: "\uAC54\uB124\uB294 \uC5C4\uB9C8\uB791 \uAC19\uC774 \uB180\uB358\uB370
      \uB098\uB9CC \uD56D\uC0C1 \uD63C\uC790\uC600\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938571
    m_Localized: "\uC6B0\uB9AC \uC5C4\uB9C8\uB294 \uB098 \uC798 \uB54C\uB9CC \uC654\uB2E4\uAC00\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938572
    m_Localized: "\uC194\uC774\uB97C \uC2EB\uC5B4\uD558\uB294 \uAC8C \uD655\uC2E4\uD574\uC694... "
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938573
    m_Localized: "\uBD80\uBAA8\uB2D8\uC774 \uB9CE\uC774 \uBC14\uC058\uC168\uB098\uBCF4\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938574
    m_Localized: "\uC194\uC774\uB97C \uC2EB\uC5B4\uD558\uC9C4 \uC54A\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938575
    m_Localized: "\uADF8\uB7F0\uAC00\uC694...? \uADF8\uB807\uACA0\uC8E0....??"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938576
    m_Localized: "\uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC \uC870\uAE08 \uC548\uC2EC\uC774
      \uB3FC\uC694...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 3626573823938577
    m_Localized: "\uAC10\uC0AC\uD574\uC694 {playerName}\uB2D8!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 4265420039589888
    m_Localized: "\uC0AC\uC2E4... \uC194\uC774\uAC00 \uBAB8\uC774 \uC880 \uC544\uD30C\uC11C...."
    m_Metadata:
      m_Items: []

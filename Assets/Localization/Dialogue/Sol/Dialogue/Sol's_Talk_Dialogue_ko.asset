MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Sol's_Talk_Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: fcf31ff2fc800354fac010d7b801150b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16332620238848
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, {playerName}\uB2D8! \uC624\uB298\uC740
      \uC5B4\uB5A4 \uC774\uC57C\uAE30\uBD80\uD130 \uD574 \uBCFC\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 16332674764800
    m_Localized: "\uB0A0\uC528\uAC00 \uC88B\uC544\uC11C \uB6F0\uC5B4\uB180\uACE0
      \uC2F6\uC5B4\uC694. \uC870\uAE08\uB9CC \uAC19\uC774 \uAC78\uC5B4\uB3C4 \uB420\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 16332674764801
    m_Localized: "\u2018\uB091\u2019\uC774 \uC624\uB298\uC740 \uC6A9\uAC10\uD558\uB300\uC694.
      \uADF8\uB798\uC11C \uC800\uB3C4 \uC6A9\uAC10\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 16332674764802
    m_Localized: "\uC800\u2026 \uC694\uC998\uC740 \uC798 \uC790\uC694. \uC545\uBABD\uB3C4
      \uAC70\uC758 \uC548 \uAFD4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153408
    m_Localized: "{playerName}\uB2D8\uC774 \uC624\uBA74 \uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC838\uC694.
      \uADF8\uB798\uC11C \uAE30\uB2E4\uB838\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153409
    m_Localized: "\uB6F0\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC774 \uCFF5\uCFF5\uD574\uC694.
      \uB300\uC2E0 \uCC9C\uCC9C\uD788\uB77C\uB3C4 \uAC19\uC774 \uC788\uC5B4 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153410
    m_Localized: "\uBC16\uC5D0\uC11C \uC6C3\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74
      \uC800\uB3C4 \uB530\uB77C \uC6C3\uAC8C \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153411
    m_Localized: "\uBE44 \uC624\uB294 \uB0A0\uC5D0\uB3C4 \uC88B\uC544\uC694. \uBE57\uBC29\uC6B8
      \uC18C\uB9AC\uAC00 \uC790\uC7A5\uAC00 \uAC19\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153412
    m_Localized: "\uC800\uB294 \uBE44\uBC00\uC744 \uC798 \uC9C0\uCF1C\uC694. \uADF8\uB798\uC11C
      \uC0AC\uB78C\uB4E4 \uC598\uAE30\uB97C \uC870\uC6A9\uD788 \uB4E4\uC5B4\uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153413
    m_Localized: "\uC624\uB298\uC740 \u2018\uB091\u2019\uC774\uB791 \uADF8\uB9BC\uC77C\uAE30
      \uC4F0\uB824\uACE0\uC694. {playerName}\uB2D8\uB3C4 \uAC19\uC774 \uC368 \uC904\uB798\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153414
    m_Localized: "\uC0AC\uC2E4 \uC804\u2026 \uC529\uC529\uD55C \uAC8C \uC7A5\uC810\uC774\uC5D0\uC694.
      \uC529\uC529\uD558\uBA74 \uB35C \uC544\uD508 \uAC83 \uAC19\uAC70\uB4E0\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153415
    m_Localized: "\uC5B8\uC820\uAC00 \uD559\uAD50 \uC6B4\uB3D9\uC7A5\uC5D0\uC11C
      \uC804\uB825 \uC9C8\uC8FC\uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153416
    m_Localized: "{playerName}\uB2D8\uC740 \uC88B\uC544\uD558\uB294 \uB180\uC774\uAC00
      \uBB50\uC608\uC694? \uC800\uB294 \uC220\uB798\uC7A1\uAE30\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153417
    m_Localized: "\uAC00\uB054 \uAC00\uC2B4\uC774 \uB450\uADFC\uB450\uADFC\uD574\uB3C4\u2026
      \uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694. \uACE7 \uAD1C\uCC2E\uC544\uC838\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153418
    m_Localized: "\uC5B4\uB978\uB4E4\uC740 \uC800\uB97C \uC870\uC2EC\uC870\uC2EC
      \uB300\uD574\uC694. \uADF8\uB798\uB3C4 \uC800\uB294 \uC529 \uC6C3\uC5B4 \uC904
      \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153419
    m_Localized: "\uC18C\uC6D0 \uD558\uB098\uB9CC \uB9D0\uD574\uB3C4 \uB3FC\uC694?
      \uCE5C\uAD6C\uB4E4\uC774\uB791 \uD574\uC9C8\uB158\uAE4C\uC9C0 \uB180\uACE0
      \uC2F6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153420
    m_Localized: "\uC9D1 \uC548 \uB0C4\uC0C8\uAC00 \uC88B\uC544\uC694. \uB530\uB73B\uD558\uACE0,
      \uB2EC\uCF64\uD558\uACE0\u2026 \uC548\uC804\uD55C \uB0C4\uC0C8\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153421
    m_Localized: "\uAC00\uB054 \uCC3D\uBC16\uC744 \uC624\uB798 \uBD10\uC694. \uB098\uAC00\uC9C4
      \uC54A\uC544\uB3C4, \uBC14\uB78C \uC18C\uB9AC\uB97C \uB4E4\uC744 \uC218 \uC788\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153422
    m_Localized: "\uC544\uD508 \uB0A0\uC5D0\uB3C4 \uC88B\uC740 \uC77C\uC740 \uC788\uC5B4\uC694.
      {playerName}\uB2D8\uC774 \uC640 \uC8FC\uB294 \uAC70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153423
    m_Localized: "\u2018\uB091\u2019 \uC190\uC744 \uAF2D \uC7A1\uACE0 \uBC84\uD2F0\uBA74,
      \uC660\uC9C0 \uBB50\uB4E0 \uD574\uB0BC \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153424
    m_Localized: "\uC5B8\uC820\uAC00 \uBCC4\uC744 \uBCF4\uB7EC \uAC00\uACE0 \uC2F6\uC5B4\uC694.
      \uBC24\uD558\uB298\uC5D0\uC11C \uAE38\uC744 \uCC3E\uB294 \uC5F0\uC2B5\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153425
    m_Localized: "\uBE44\uBC00 \uD558\uB098 \uC54C\uB824 \uC904\uAE4C\uC694? \uC0AC\uC2E4
      \uC804, \uC624\uB298\uC744 \uAF49 \uC7A1\uACE0 \uC2F6\uC5B4\uC694. \uB0B4\uC77C\uC774
      \uAC71\uC815\uB420 \uB54C\uB3C4 \uC788\uAC70\uB4E0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153426
    m_Localized: "\uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC544\uC694. {playerName}\uB2D8\uC774
      \uC606\uC5D0 \uC788\uC73C\uBA74 \uC6A9\uAE30\uAC00 \uB098\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16332683153427
    m_Localized: "\uB0B4\uC77C\uB3C4 \uC640 \uC8FC\uC2E4 \uAC70\uC8E0? \uC800\uB294
      \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9B4\uAC8C\uC694. \uC57D\uC18D\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

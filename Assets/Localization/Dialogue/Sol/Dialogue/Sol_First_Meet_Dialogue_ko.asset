  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Sol_First_Meet_Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 3d4d168b851240847bf1d6a09ef8f32d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 238400507904
    m_Localized: "\uC55E\uC73C\uB85C \uB110 \uB3CC\uBD10\uC8FC\uC2E4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 5172039680
    m_Localized: "\uC194\uC774 \uC548\uB155? \uC774\uCABD\uC740 \uC0C8\uB85C \uC628
      {playerName}\uB2D8\uC774\uC154."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976980905984
    m_Localized: "\uC557, \uC548\uB155\uD558\uC138\uC694! \uC800\uB294 \uC194\uC774\uC5D0\uC694...!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976980905985
    m_Localized: "\uC774\uC81C \uB098\uB294 \uC774\uB9CC \uAC00\uBCFC\uAC8C. \uC194\uC774\uB791
      \uC598\uAE30 \uC798 \uB098\uB220\uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100288
    m_Localized: "\uC800\uB97C \uB3CC\uBD10\uC8FC\uC2E4 \uBD84\uC774\uB77C\uB2C8...
      \uB108\uBB34 \uC88B\uB124\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100289
    m_Localized: "\uADFC\uB370 \uC6B0\uB9AC \uC5C4\uB9C8\uC544\uBE60\uCC98\uB7FC
      \uC9C0\uCE58\uBA74... \uC548 \uB418\uB294\uB370...."
    m_Metadata:
      m_Items: []
  - m_Id: 9147165118464
    m_Localized: "\uC548 \uC9C0\uCE58\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100290
    m_Localized: "\uADF8\uB7F4\uB9AC\uAC00! "
    m_Metadata:
      m_Items: []
  - m_Id: 9420180754432
    m_Localized: "...! \uC557, \uB4E4\uC5C8\uAD6C\uB098... \uC751!! \uACE0\uB9C8\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 9567400824832
    m_Localized: "\uC194\uC774\uAC00 \uC9C0\uAE08 \uB9DE\uACE0 \uC788\uB294 \uC8FC\uC0AC\uB294
      \uBB50\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 220647078752256
    m_Localized: "\uC774, \uC774\uAC74! \uBCC4 \uAC70 \uC544\uB2C8\uC5D0\uC694. \uD558\uD558..."
    m_Metadata:
      m_Items: []
  - m_Id: 220649352065024
    m_Localized: "\uC815\uB9D0 \uC870\uAE08 \uBAB8\uC774 \uC548 \uC88B\uC544\uC11C
      \uADF8\uB798\uC694...!!"
    m_Metadata:
      m_Items: []
  - m_Id: 221271946162176
    m_Localized: "\uB9C8\uC74C\uC758 \uC0C1\uCC98? \uADF8\uAC8C \uBB34\uC2A8 \uB73B\uC774\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100292
    m_Localized: "\uC544\uBB34\uD2BC \uC194\uC774\uD55C\uD14C \uC788\uB294 \uC0C1\uCC98\uB294
      \uBCC4 \uAC70 \uC544\uB2C8\uC5D0\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100293
    m_Localized: "\uC194\uC774\uAC00 \uC88B\uC544\uD558\uB294 \uAC74 \uC548 \uAD81\uAE08\uD574\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100294
    m_Localized: "\uB098\uB294~ \uB180\uC774\uD130\uC5D0\uC11C \uB178\uB294 \uAC83\uB3C4
      \uC88B\uC544\uD558\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100295
    m_Localized: "\uB180\uC774\uACF5\uC6D0\uB3C4 \uAC00\uACE0 \uC2F6\uACE0!! \uB180\uACE0
      \uC2F6\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100296
    m_Localized: "\uAC19\uC774 \uB180\uB7EC \uB098\uAC00\uBA74 \uC548 \uB3FC\uC694?
      \uC751?"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100297
    m_Localized: "\uC751, \uB0B4\uC77C \uB180\uB7EC\uB098\uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100298
    m_Localized: "\uB2F9\uC5F0\uD788 \uADF8\uB798\uC904 \uC218 \uC788\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100291
    m_Localized: "\uC544, \uD639\uC2DC \uB098\uD55C\uD14C \uAD81\uAE08\uD55C \uAC70
      \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 20500135219200
    m_Localized: "\uB108\uB294 \uC5B4\uB5A4 \uB9C8\uC74C\uC758 \uC0C1\uCC98\uB97C
      \uAC16\uACE0 \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100299
    m_Localized: "\uC544\uC2F8~! \uC2E0\uB09C\uB2E4!! \uB0B4\uC77C \uC6B0\uB9AC \uC9D1\uC73C\uB85C
      \uAF2D \uC640\uC694. \uAE30\uB2E4\uB9B4\uAC8C\uC694!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

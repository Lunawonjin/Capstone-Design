  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Sol_First_Meet_Dialogue_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 3d4d168b851240847bf1d6a09ef8f32d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 238400507904
    m_Localized: "Oh, hello! I\u2019m Sol\u2026!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976980905984
    m_Localized: "Hi, I\u2019m {playerName}. "
    m_Metadata:
      m_Items: []
  - m_Id: 16216976980905985
    m_Localized: "What\u2019s Sol sick with?\nI saw you getting injections."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100288
    m_Localized: "I\u2026 I have leukemia.\nThey said I\u2019ve had it since I was
      young!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100289
    m_Localized: "That too bad\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 9147165118464
    m_Localized: "Oh\u2026 I see."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100290
    m_Localized: 'Adaults always react like this.

      Heh-heh!'
    m_Metadata:
      m_Items: []
  - m_Id: 9420180754432
    m_Localized: "But it doesn\u2019t hurt now, so I\u2019m happy! "
    m_Metadata:
      m_Items: []
  - m_Id: 9567400824832
    m_Localized: "Haha! That\u2019s such a relief."
    m_Metadata:
      m_Items: []
  - m_Id: 220647078752256
    m_Localized: "I wish I could\u2019ve gone to school\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 220649352065024
    m_Localized: "Sorry\u2026? Well\u2026 I was taught that I should\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 221271946162176
    m_Localized: "You\u2019ve been to school, right?\nI haven\u2019t though..."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100292
    m_Localized: I want to play with friends at school!
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100293
    m_Localized: "I just have only Kkin\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100295
    m_Localized: Kkin?
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100296
    m_Localized: 'Kkin is my best friend.

      This rabbit doll right here!'
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100297
    m_Localized: "Kkin is my sole friend\u2026 "
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100298
    m_Localized: "Mommy and Daddy were working hard for me,\nso they couldn\u2019t
      come often."
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100299
    m_Localized: "That\u2019s why Kkin is super precious to me!"
    m_Metadata:
      m_Items: []
  - m_Id: 16216976985100291
    m_Localized: Sol is totally the strongest!
    m_Metadata:
      m_Items: []
  - m_Id: 20500135219200
    m_Localized: Why do you act so cheerful like this?
    m_Metadata:
      m_Items: []
  - m_Id: 5172039680
    m_Localized: "Hi, Sol. This is {playerName}.\nFrom now on, she\u2019ll be looking
      after you."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

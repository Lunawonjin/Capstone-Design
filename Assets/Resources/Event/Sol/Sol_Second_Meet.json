using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.SceneManagement;

// JsonEventSequenceRunner
// - TextAsset(JSON) 기반으로 Sol 두 번째 만남 같은 이벤트 시퀀스를 실행하는 스크립트
// - 기능 요약
//   1) JSON 로드 (player, npcSpawns, steps, afterPlayerActions 등)
//   2) Player 이동 (Rigidbody2D 또는 Transform.position 사용)
//   3) Sol 스폰 또는 위치 이동
//   4) afterPlayerActions:
//        type == "dialogue"    -> 대사 재생 후 완료까지 대기
//        type == "changeScene" -> DataManager.ChangeSceneWithSubSave 또는 SceneManager.LoadScene 호출
//
// 사용 방법 예시
//   - 빈 GameObject에 이 스크립트 부착
//   - jsonConfig 에 위에서 만든 JSON(TextAsset) 지정
//   - playerTransform, playerRigidbody2D 연결 (또는 태그 "Player" 자동 검색 사용)
//   - autoRunOnStart 또는 외부에서 StartSequence() 호출
//
// 주의
//   - ChattingManger 쪽에 StartNpcDialogueByFirstCondition(string eventName, Action onFinished) 형태의
//     콜백 지원 메서드가 있다고 가정하고 작성했다.
//     만약 현재 프로젝트에 콜백 버전이 없다면, 해당 부분을 주석 참고해서 수정해 사용하면 된다.

[DisallowMultipleComponent]
public class JsonEventSequenceRunner : MonoBehaviour
{
    [Header("JSON 설정 파일(TextAsset)")]
    [SerializeField] private TextAsset jsonConfig;

    [Header("자동 실행 옵션")]
    [Tooltip("체크 시: Start에서 자동으로 시퀀스를 한 번 실행")]
    [SerializeField] private bool autoRunOnStart = false;

    [Header("플레이어 참조")]
    [Tooltip("비워두면 태그 'Player'로 자동 검색")]
    [SerializeField] private Transform playerTransform;
    [Tooltip("Rigidbody2D가 있을 경우 이동에 사용 (선택)")]
    [SerializeField] private Rigidbody2D playerRigidbody2D;

    [Header("NPC 프리셋 또는 자동 검색 옵션")]
    [Tooltip("Sol을 자동으로 찾을 때 사용할 태그 (비워두면 이름 검색 사용)")]
    [SerializeField] private string solTag = "";
    [Tooltip("Sol을 찾을 때 사용할 기본 이름")]
    [SerializeField] private string solDefaultName = "Sol";
    [Tooltip("Sol이 없을 경우 생성할 프리팹 (선택 사항)")]
    [SerializeField] private GameObject solPrefab;

    [Header("디버그 옵션")]
    [SerializeField] private bool logDebug = true;

    // JSON 구조 정의
    [Serializable]
    public class PlayerConfig
    {
        public bool forceUsePlayerMoveSpeed = true;
        public float moveSpeed = 1.0f;
    }

    [Serializable]
    public class NpcSpawnConfig
    {
        public string npcName;
        public float x;
        public float y;
        public float z;
        public bool deactivateExisting = true;
        public bool relativeToPlayer = false;
    }

    [Serializable]
    public class StepConfig
    {
        // "x", "y" 중 하나 사용 (JSON: "axis": "y")
        public string axis = "x";
        // 해당 축으로 이동할 거리 (양수: +방향, 음수: -방향)
        public float delta = 0f;
        // 0이면 defaultStepDuration 사용
        public float duration = 0f;
    }

    [Serializable]
    public class AfterPlayerActionConfig
    {
        // "dialogue", "changeScene" 등
        public string type;

        // type == "dialogue" 에 사용
        public string owner;      // 예: "Sol"
        public string eventName;  // 예: "Sol_Second_Meet"

        // type == "changeScene" 에 사용
        public string sceneName;      // 예: "SolsGamePuzzle"
        public bool useSubSave = true;
    }

    [Serializable]
    public class DialogueReactionActionConfig
    {
        public string type;       // 예: "cameraShake", "sfx" 등
        public float duration;
        public float delta;
    }

    [Serializable]
    public class DialogueReactionConfig
    {
        public string onKey;      // 예: "Dialogue_002"
        public DialogueReactionActionConfig[] actions;
    }

    [Serializable]
    public class SequenceConfig
    {
        public float defaultStepDuration = 1.0f;
        public bool useWorldSpace = true;
        public bool useRigidbodyMove = true;

        public PlayerConfig player = new PlayerConfig();
        public NpcSpawnConfig[] npcSpawns = Array.Empty<NpcSpawnConfig>();
        public StepConfig[] steps = Array.Empty<StepConfig>();
        public AfterPlayerActionConfig[] afterPlayerActions = Array.Empty<AfterPlayerActionConfig>();
        public DialogueReactionConfig[] dialogueReactions = Array.Empty<DialogueReactionConfig>();
    }

    // 실제 파싱된 설정
    private SequenceConfig _config;
    private bool _isRunning = false;

    void Start()
    {
        if (autoRunOnStart)
        {
            StartSequence();
        }
    }

    // 외부에서 호출할 public API
    public void StartSequence()
    {
        if (_isRunning)
        {
            if (logDebug) Debug.Log("[JsonEventSequenceRunner] 이미 시퀀스가 실행 중입니다.");
            return;
        }

        if (!LoadConfigFromJson())
        {
            Debug.LogError("[JsonEventSequenceRunner] JSON 설정 로드 실패. 실행 불가.");
            return;
        }

        EnsurePlayerReference();
        StartCoroutine(RunSequenceCoroutine());
    }

    // JSON 파싱
    private bool LoadConfigFromJson()
    {
        if (jsonConfig == null)
        {
            Debug.LogError("[JsonEventSequenceRunner] jsonConfig(TextAsset)이 비어있습니다.");
            return false;
        }

        try
        {
            _config = JsonUtility.FromJson<SequenceConfig>(jsonConfig.text);
            if (_config == null)
            {
                Debug.LogError("[JsonEventSequenceRunner] JsonUtility.FromJson 결과가 null 입니다.");
                return false;
            }

            if (_config.player == null)
                _config.player = new PlayerConfig();

            if (_config.npcSpawns == null)
                _config.npcSpawns = Array.Empty<NpcSpawnConfig>();

            if (_config.steps == null)
                _config.steps = Array.Empty<StepConfig>();

            if (_config.afterPlayerActions == null)
                _config.afterPlayerActions = Array.Empty<AfterPlayerActionConfig>();

            if (_config.dialogueReactions == null)
                _config.dialogueReactions = Array.Empty<DialogueReactionConfig>();

            if (logDebug)
            {
                Debug.Log("[JsonEventSequenceRunner] JSON 설정 로드 완료.");
            }

            return true;
        }
        catch (Exception e)
        {
            Debug.LogError("[JsonEventSequenceRunner] JSON 파싱 중 예외: " + e);
            return false;
        }
    }

    // Player 참조 확보
    private void EnsurePlayerReference()
    {
        if (!playerTransform)
        {
            var playerGo = GameObject.FindGameObjectWithTag("Player");
            if (playerGo != null)
            {
                playerTransform = playerGo.transform;
            }
        }

        if (!playerTransform)
        {
            var go = GameObject.Find("Player");
            if (go != null)
                playerTransform = go.transform;
        }

        if (!playerRigidbody2D && playerTransform != null)
        {
            playerRigidbody2D = playerTransform.GetComponent<Rigidbody2D>();
        }

        if (!playerTransform && logDebug)
        {
            Debug.LogWarning("[JsonEventSequenceRunner] Player를 찾지 못했습니다. 이동 기능이 정상 동작하지 않을 수 있습니다.");
        }
    }

    // 전체 시퀀스를 실행하는 코루틴
    private IEnumerator RunSequenceCoroutine()
    {
        _isRunning = true;

        // 1) NPC 스폰/위치 설정
        yield return SpawnOrPlaceNpcs();

        // 2) 플레이어 이동(step들 실행)
        yield return RunPlayerSteps();

        // 3) afterPlayerActions 실행
        yield return RunAfterPlayerActions();

        _isRunning = false;
    }

    // NPC 스폰 또는 위치 이동
    private IEnumerator SpawnOrPlaceNpcs()
    {
        if (_config.npcSpawns == null || _config.npcSpawns.Length == 0)
            yield break;

        foreach (var npcCfg in _config.npcSpawns)
        {
            if (npcCfg == null) continue;

            if (string.Equals(npcCfg.npcName, "Sol", StringComparison.OrdinalIgnoreCase))
            {
                HandleSolSpawnOrMove(npcCfg);
            }
            else
            {
                // 다른 NPC가 필요하다면 여기서도 확장 가능
                HandleGenericNpcSpawnOrMove(npcCfg);
            }
        }

        yield return null;
    }

    private void HandleSolSpawnOrMove(NpcSpawnConfig cfg)
    {
        GameObject sol = FindNpcByNameOrTag(solDefaultName, solTag);

        if (cfg.deactivateExisting && sol != null)
        {
            sol.SetActive(false);
            sol = null;
        }

        if (sol == null && solPrefab != null)
        {
            Vector3 spawnPos = new Vector3(cfg.x, cfg.y, cfg.z);
            if (cfg.relativeToPlayer && playerTransform != null)
            {
                spawnPos = playerTransform.position + new Vector3(cfg.x, cfg.y, cfg.z);
            }

            sol = Instantiate(solPrefab, spawnPos, Quaternion.identity);
            sol.name = string.IsNullOrEmpty(cfg.npcName) ? solDefaultName : cfg.npcName;

            if (logDebug)
            {
                Debug.Log("[JsonEventSequenceRunner] Sol 프리팹 생성: " + sol.transform.position);
            }
        }
        else if (sol != null)
        {
            Vector3 pos = new Vector3(cfg.x, cfg.y, cfg.z);
            if (cfg.relativeToPlayer && playerTransform != null)
            {
                pos = playerTransform.position + new Vector3(cfg.x, cfg.y, cfg.z);
            }

            sol.transform.position = pos;
            if (!sol.activeSelf) sol.SetActive(true);

            if (logDebug)
            {
                Debug.Log("[JsonEventSequenceRunner] 기존 Sol 위치 이동: " + sol.transform.position);
            }
        }
    }

    private void HandleGenericNpcSpawnOrMove(NpcSpawnConfig cfg)
    {
        GameObject npc = FindNpcByName(cfg.npcName);

        if (cfg.deactivateExisting && npc != null)
        {
            npc.SetActive(false);
            npc = null;
        }

        if (npc == null)
        {
            // 특정 프리팹이 필요하다면, 이름 매칭을 통해 프리팹 배열을 찾는 로직을 추가해서 사용하면 된다.
            if (logDebug)
            {
                Debug.Log("[JsonEventSequenceRunner] '" + cfg.npcName + "' NPC를 찾지 못했고 프리팹도 설정되지 않아 스폰을 건너뜁니다.");
            }
            return;
        }

        Vector3 pos = new Vector3(cfg.x, cfg.y, cfg.z);
        if (cfg.relativeToPlayer && playerTransform != null)
        {
            pos = playerTransform.position + new Vector3(cfg.x, cfg.y, cfg.z);
        }

        npc.transform.position = pos;
        if (!npc.activeSelf) npc.SetActive(true);

        if (logDebug)
        {
            Debug.Log("[JsonEventSequenceRunner] NPC '" + cfg.npcName + "' 위치 이동: " + npc.transform.position);
        }
    }

    private GameObject FindNpcByNameOrTag(string defaultName, string tag)
    {
        GameObject npc = null;

        if (!string.IsNullOrEmpty(tag))
        {
            npc = GameObject.FindGameObjectWithTag(tag);
            if (npc != null) return npc;
        }

        npc = GameObject.Find(defaultName);
        return npc;
    }

    private GameObject FindNpcByName(string name)
    {
        if (string.IsNullOrEmpty(name)) return null;
        return GameObject.Find(name);
    }

    // 플레이어 이동 step 실행
    private IEnumerator RunPlayerSteps()
    {
        if (_config.steps == null || _config.steps.Length == 0)
            yield break;

        if (!playerTransform)
        {
            if (logDebug) Debug.LogWarning("[JsonEventSequenceRunner] PlayerTransform이 없어서 이동을 건너뜁니다.");
            yield break;
        }

        foreach (var step in _config.steps)
        {
            if (step == null) continue;
            yield return MovePlayerStep(step);
        }
    }

    private IEnumerator MovePlayerStep(StepConfig step)
    {
        if (!playerTransform) yield break;

        Vector3 dir = Vector3.zero;
        string axis = (step.axis ?? "x").ToLowerInvariant();

        if (axis == "x")
        {
            dir = new Vector3(step.delta, 0f, 0f);
        }
        else if (axis == "y")
        {
            dir = new Vector3(0f, step.delta, 0f);
        }
        else
        {
            if (logDebug) Debug.LogWarning("[JsonEventSequenceRunner] 지원하지 않는 axis 값: " + step.axis);
            yield break;
        }

        float distance = Mathf.Abs(step.delta);
        float duration = step.duration > 0f ? step.duration : _config.defaultStepDuration;

        // forceUsePlayerMoveSpeed 설정이 켜져 있다면, 속도 기반으로 시간 계산
        if (_config.player != null && _config.player.forceUsePlayerMoveSpeed && _config.player.moveSpeed > 0f)
        {
            if (distance > 0f)
            {
                duration = distance / _config.player.moveSpeed;
            }
        }

        if (duration <= 0f)
        {
            // 시간 0이면 즉시 이동
            playerTransform.position += dir;
            yield break;
        }

        Vector3 startPos = playerTransform.position;
        Vector3 targetPos = startPos + dir;

        float elapsed = 0f;

        if (_config.useRigidbodyMove && playerRigidbody2D != null)
        {
            // Rigidbody2D를 이용한 부드러운 이동
            while (elapsed < duration)
            {
                elapsed += Time.deltaTime;
                float t = Mathf.Clamp01(elapsed / duration);
                Vector3 newPos = Vector3.Lerp(startPos, targetPos, t);
                playerRigidbody2D.MovePosition(newPos);
                yield return null;
            }
        }
        else
        {
            // Transform.position 기반 이동
            while (elapsed < duration)
            {
                elapsed += Time.deltaTime;
                float t = Mathf.Clamp01(elapsed / duration);
                Vector3 newPos = Vector3.Lerp(startPos, targetPos, t);
                playerTransform.position = newPos;
                yield return null;
            }
        }

        playerTransform.position = targetPos;
    }

    // afterPlayerActions 처리
    private IEnumerator RunAfterPlayerActions()
    {
        if (_config.afterPlayerActions == null || _config.afterPlayerActions.Length == 0)
            yield break;

        foreach (var act in _config.afterPlayerActions)
        {
            if (act == null) continue;

            string type = (act.type ?? "").ToLowerInvariant();

            switch (type)
            {
                case "dialogue":
                    yield return RunDialogueAction(act);
                    break;

                case "changescene":
                    yield return RunChangeSceneAction(act);
                    // changeScene 이후에는 씬이 전환되므로 더 이상 로컬 시퀀스를 실행하지 않는다.
                    yield break;

                default:
                    if (logDebug)
                    {
                        Debug.LogWarning("[JsonEventSequenceRunner] 알 수 없는 afterPlayerAction type: " + act.type);
                    }
                    break;
            }
        }
    }

    // type == "dialogue"
    private IEnumerator RunDialogueAction(AfterPlayerActionConfig act)
    {
        if (string.IsNullOrEmpty(act.eventName))
        {
            if (logDebug) Debug.LogWarning("[JsonEventSequenceRunner] dialogue 액션에 eventName이 비어 있습니다.");
            yield break;
        }

        // ChattingManger에 콜백 지원 메서드가 있다고 가정
        // 예: StartNpcDialogueByFirstCondition(string eventName, Action onFinished)
        if (ChattingManger.Instance == null)
        {
            Debug.LogWarning("[JsonEventSequenceRunner] ChattingManger.Instance가 없습니다. 대사 실행 불가.");
            yield break;
        }

        bool finished = false;

        try
        {
            // 이 부분은 실제 프로젝트의 ChattingManger 시그니처에 맞춰 수정 가능
            ChattingManger.Instance.StartNpcDialogueByFirstCondition(act.eventName, () =>
            {
                finished = true;
            });
        }
        catch (Exception e)
        {
            Debug.LogError("[JsonEventSequenceRunner] 대사 시작 중 예외. ChattingManger 메서드 시그니처가 다를 수 있습니다.\n" + e);
            yield break;
        }

        // 안전 타임아웃을 둔다 (예: 최대 300초)
        float timeout = 300f;
        float elapsed = 0f;

        while (!finished && elapsed < timeout)
        {
            elapsed += Time.unscaledDeltaTime;
            yield return null;
        }

        if (!finished && logDebug)
        {
            Debug.LogWarning("[JsonEventSequenceRunner] 대사 완료 콜백이 오지 않았지만 타임아웃으로 다음 단계로 진행합니다.");
        }
    }

    // type == "changeScene"
    private IEnumerator RunChangeSceneAction(AfterPlayerActionConfig act)
    {
        if (string.IsNullOrEmpty(act.sceneName))
        {
            Debug.LogError("[JsonEventSequenceRunner] changeScene 액션에 sceneName이 비어 있습니다.");
            yield break;
        }

        if (logDebug)
        {
            Debug.Log("[JsonEventSequenceRunner] changeScene 액션 실행: " + act.sceneName + " (useSubSave=" + act.useSubSave + ")");
        }

        // DataManager를 통한 SubSave + 씬 변경
        if (act.useSubSave && DataManager.instance != null)
        {
            DataManager.instance.ChangeSceneWithSubSave(act.sceneName);
        }
        else
        {
            SceneManager.LoadScene(act.sceneName);
        }

        yield break;
    }
}
